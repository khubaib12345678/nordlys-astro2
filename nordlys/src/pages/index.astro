---
/**
 * index.astro - the landing page.
 * `prerender = false` makes this route run on the edge per request, which the
 * contact form needs (it handles POST). Static pages elsewhere stay static.
 */
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ContactForm from '../components/ContactForm.astro';

// Content lives in data so the markup stays small and easy to edit.
const services = [
  {
    title: 'Webflow to Astro migration',
    body: 'We rebuild your Webflow pages as Astro components, keep the design identical, and keep your URLs so search rankings carry over.',
    featured: true,
  },
  { title: 'CMS and content modelling', body: 'Webflow CMS collections become typed Astro content collections or a headless CMS your editors already know.' },
  { title: 'Performance', body: 'Pages ship HTML and CSS, with JavaScript only where something is interactive.' },
  { title: 'Design systems in Tailwind', body: 'Your styles become tokens and components, so new pages reuse them instead of copying them.' },
  { title: 'Edge hosting', body: 'Deployed on Cloudflare with preview URLs per branch and instant rollbacks.' },
  { title: 'Forms and integrations', body: 'Contact forms, email through Resend, and small APIs on Railway when a page needs a backend.', wide: true },
];

// Before/after rows for the hero panel. Qualitative on purpose: no invented numbers.
const changes = [
  ['Page output', 'Generated by Webflow runtime', 'Plain HTML from your components'],
  ['JavaScript', 'Loaded on every page', 'Only on interactive parts'],
  ['Hosting', 'Webflow plan', 'Cloudflare'],
  ['Code ownership', 'Inside the editor', 'Your Git repository'],
];
---

<Layout title="Nordlys | Webflow to Astro migrations">
  <Navbar />

  <main id="main">
    <!-- HERO -->
    <section class="mx-auto grid max-w-6xl gap-14 px-6 pb-24 pt-20 lg:grid-cols-12 lg:pt-28">
      <div class="lg:col-span-7">
        <h1 class="text-5xl font-semibold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">
          Move from Webflow to Astro without redesigning a thing.
        </h1>
        <p class="mt-8 max-w-xl text-lg text-muted">
          Nordlys is a small team of engineers that rebuilds Webflow sites in Astro. Same design, same URLs, faster pages, and code your own developers can read.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="#contact" class="rounded-full bg-accent px-7 py-3 font-medium text-accent-ink transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">Start a migration</a>
          <a href="#services" class="rounded-full border border-line px-7 py-3 font-medium transition-colors hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">See what we do</a>
        </div>
      </div>

      <!-- What changes: the single animated element -->
      <div class="settle lg:col-span-5" aria-label="What changes in a migration">
        <div class="overflow-hidden rounded-2xl border border-line bg-surface">
          <div class="grid grid-cols-2 border-b border-line text-sm font-medium">
            <p class="px-5 py-3 text-muted">Webflow</p>
            <p class="border-l border-line px-5 py-3 text-accent">Astro</p>
          </div>
          {changes.map(([label, before, after]) => (
            <div class="border-b border-line last:border-b-0">
              <p class="px-5 pt-3 text-sm text-muted">{label}</p>
              <div class="grid grid-cols-2 pb-3">
                <p class="px-5 pt-1 text-sm">{before}</p>
                <p class="border-l border-line px-5 pt-1 text-sm font-medium">{after}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section id="services" class="border-t border-line">
      <div class="mx-auto max-w-6xl px-6 py-24">
        <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">Everything a Webflow site needs to live in code</h2>
        <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
          {services.map((s) => (
            <article class:list={['bg-surface p-8', s.featured && 'sm:col-span-2', s.wide && 'sm:col-span-2 lg:col-span-3']}>
              <h3 class:list={['font-semibold tracking-tight', s.featured ? 'text-2xl' : 'text-lg']}>{s.title}</h3>
              <p class="mt-3 max-w-lg text-muted">{s.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <ContactForm />
  </main>

  <footer class="border-t border-line">
    <p class="mx-auto max-w-6xl px-6 py-8 text-sm text-muted">&copy; {new Date().getFullYear()} Nordlys. Portfolio demo project.</p>
  </footer>
</Layout>
